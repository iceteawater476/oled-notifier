<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OLED Notify Relay"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/grantAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant notification access" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device IP address"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/deviceIpInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 192.168.1.42"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Only forward these apps (comma-separated, optional)"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/onlyAppsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. whatsapp, telegram"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ignore these apps (comma-separated, optional)"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/ignoreAppsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. spotify"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duration shown on OLED (ms)"
            android:paddingTop="16dp" />
        <EditText
            android:id="@+id/durationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save settings" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Send test notification" />

    </LinearLayout>
</ScrollView>
